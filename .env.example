# Google Maps Platform
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── Email Finder API keys (add whichever you have — chain skips missing ones) ──
# Tier 2 providers are tried in this order after free website scrape + pattern guess

# Apollo.io — 50 free/month, best quality (sign up: apollo.io)
APOLLO_API_KEY=your_apollo_api_key_here

# Snov.io — 50 free/month, good global coverage (sign up: snov.io)
SNOV_CLIENT_ID=your_snov_client_id_here
SNOV_CLIENT_SECRET=your_snov_client_secret_here

# Skrapp.io — 100 free/month (sign up: skrapp.io)
SKRAPP_API_KEY=your_skrapp_api_key_here

# Findthat.email — 50 free/month (sign up: findthat.email)
FINDTHAT_API_KEY=your_findthat_api_key_here

# Hunter.io — 25 free/month, used last (sign up: hunter.io)
HUNTER_API_KEY=your_hunter_api_key_here

# SMTP — works with Gmail App Password, SendGrid, Mailgun, AWS SES, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_NAME=Your Name

# App
SECRET_KEY=change_this_to_a_random_string
DATABASE_URL=sqlite:///./leadgen.db

# Optional: daily send limit to avoid spam flags
MAX_EMAILS_PER_DAY=50
